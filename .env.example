# Copy to .env and adjust. Never commit .env.
COMPOSE_PROJECT_NAME=islab
WAZUH_VERSION=4.14.9
LAB_TZ=Africa/Algiers

# PUBLIC wazuh-docker defaults, matching the committed stack/config files. Do not use them:
# scripts/rotate-passwords.sh (make rotate) writes generated values here, plus
# INDEXER_USERS_FILE and DASHBOARD_API_CONFIG pointing at the git-ignored stack/secrets/.
INDEXER_PASSWORD=SecretPassword
DASHBOARD_PASSWORD=kibanaserver
API_PASSWORD=MyS3cr37P450r.*-

# Simulator. SIM_RATE = background events/second at peak (office hours).
# Office profile: full activity in SIM_OFFICE_HOURS (local LAB_TZ time) with a 1 h ramp each side,
# SIM_NIGHT_FACTOR of the peak at night, the whole day x SIM_WEEKEND_FACTOR on SIM_WEEKEND_DAYS.
SIM_RATE=0.7
SIM_PROFILE=office
SIM_OFFICE_HOURS=08-18
SIM_NIGHT_FACTOR=0.1
SIM_WEEKEND_FACTOR=0.2
SIM_WEEKEND_DAYS=fri,sat
SIM_ATTACK_MIN=120
SIM_ATTACK_MAX=300
